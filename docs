<style>
/* Direction: deep teal accent over warm neutrals, editorial contrast, Playfair Display + DM Sans */
:root {
  --bg: #FAFAF7;
  --bg-alt: #F0EFEB;
  --fg: #1A1A1A;
  --fg-muted: #5A5A56;
  --accent: #0D6B6E;
  --accent-light: #E0F2F1;
  --accent-dark: #094D4F;
  --border: #D8D6D0;
  --white: #FFFFFF;
  --warning: #C4621A;
  --success: #2E7D32;
  color-scheme: light;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #141413;
    --bg-alt: #1E1E1C;
    --fg: #E8E8E4;
    --fg-muted: #9A9A94;
    --accent: #4DB6AC;
    --accent-light: #1A2F2E;
    --accent-dark: #80CBC4;
    --border: #333330;
    --white: #1E1E1C;
    --warning: #FFB74D;
    --success: #66BB6A;
    color-scheme: dark;
  }
}

:root[data-theme="dark"] {
  --bg: #141413;
  --bg-alt: #1E1E1C;
  --fg: #E8E8E4;
  --fg-muted: #9A9A94;
  --accent: #4DB6AC;
  --accent-light: #1A2F2E;
  --accent-dark: #80CBC4;
  --border: #333330;
  --white: #1E1E1C;
  --warning: #FFB74D;
  --success: #66BB6A;
  color-scheme: dark;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
  background: var(--bg);
  color: var(--fg);
  line-height: 1.65;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3 { font-family: 'Playfair Display', Georgia, serif; text-wrap: balance; }

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

.container { max-width: 980px; margin: 0 auto; padding: 0 24px; }

/* ── Identidade Consult Egea ── */
.brand-logo { display: inline-flex; align-items: center; gap: 12px; color: var(--fg); font-weight: 700; font-size: .98rem; }
.brand-logo:hover { text-decoration: none; }
.brand-logo img { width: 56px; height: 56px; object-fit: contain; border-radius: 10px; background: #050509; }
@media (max-width: 600px) { .brand-logo span { display: none; } .brand-logo img { width: 44px; height: 44px; } }
.company-link { display: inline-block; margin-top: 12px; font-weight: 600; }
/* ── NAV ── */
nav {
  position: sticky; top: 0; z-index: 100;
  background: var(--bg); border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}
nav .container {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 14px; padding-bottom: 14px;
}
nav .logo { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; color: var(--fg); }
nav .logo span { color: var(--accent); }
nav ul { list-style: none; display: flex; gap: 28px; }
nav ul a { font-size: 0.88rem; font-weight: 500; color: var(--fg-muted); transition: color .2s; }
nav ul a:hover { color: var(--accent); text-decoration: none; }

@media (max-width: 600px) {
  nav ul { gap: 16px; }
  nav ul a { font-size: 0.8rem; }
}

/* ── HERO ── */
.hero {
  padding: 80px 0 64px;
  border-bottom: 1px solid var(--border);
}
.hero-inner { max-width: 720px; }
.hero .label {
  display: inline-block;
  font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--accent); background: var(--accent-light);
  padding: 4px 12px; border-radius: 4px; margin-bottom: 20px;
}
.hero h1 {
  font-size: clamp(2rem, 5vw, 3.2rem);
  line-height: 1.15; font-weight: 700; letter-spacing: -0.02em;
  margin-bottom: 20px;
}
.hero h1 em { font-style: normal; color: var(--accent); }
.hero p.lead {
  font-size: 1.15rem; color: var(--fg-muted); line-height: 1.7; max-width: 620px;
}
.hero .cta-row { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 12px 24px; border-radius: 6px; font-size: 0.9rem; font-weight: 600;
  border: none; cursor: pointer; transition: all .2s;
}
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-dark); text-decoration: none; }
.btn-outline { background: transparent; border: 1.5px solid var(--border); color: var(--fg); }
.btn-outline:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

/* ── STATS ── */
.stats {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
  background: var(--border); border-bottom: 1px solid var(--border);
}
.stat {
  background: var(--bg); padding: 32px 24px; text-align: center;
}
.stat .num { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 700; color: var(--accent); }
.stat .txt { font-size: 0.82rem; color: var(--fg-muted); margin-top: 4px; }

@media (max-width: 600px) {
  .stats { grid-template-columns: repeat(2, 1fr); }
}

/* ── SECTION ── */
section { padding: 72px 0; }
section + section { border-top: 1px solid var(--border); }

.section-label {
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 8px;
}
.section-title {
  font-size: 1.8rem; font-weight: 700; margin-bottom: 12px; letter-spacing: -0.01em;
}
.section-desc { color: var(--fg-muted); max-width: 600px; margin-bottom: 40px; }

/* ── EXPERTISE GRID ── */
.expertise-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
.exp-card {
  background: var(--bg-alt); border: 1px solid var(--border); border-radius: 10px;
  padding: 28px; transition: border-color .2s;
}
.exp-card:hover { border-color: var(--accent); }
.exp-card .icon {
  width: 40px; height: 40px; border-radius: 8px;
  background: var(--accent-light); color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.2rem; margin-bottom: 16px;
}
.exp-card h3 { font-size: 1.05rem; margin-bottom: 8px; font-family: 'DM Sans', sans-serif; font-weight: 600; }
.exp-card p { font-size: 0.88rem; color: var(--fg-muted); }

/* ── CASE STUDIES ── */
.case { margin-bottom: 48px; }
.case:last-child { margin-bottom: 0; }
.case-header {
  display: flex; align-items: flex-start; gap: 16px; margin-bottom: 16px;
}
.case-badge {
  flex-shrink: 0;
  width: 44px; height: 44px; border-radius: 10px;
  background: var(--accent); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 0.85rem;
}
.case h3 { font-size: 1.15rem; font-family: 'DM Sans', sans-serif; font-weight: 600; }
.case .client { font-size: 0.82rem; color: var(--accent); font-weight: 500; }
.case .body { font-size: 0.92rem; color: var(--fg-muted); margin-bottom: 16px; }
.case .tags { display: flex; flex-wrap: wrap; gap: 6px; }
.tag {
  font-size: 0.72rem; font-weight: 500; padding: 3px 10px;
  border-radius: 20px; background: var(--accent-light); color: var(--accent);
}

/* ── PRODUCTS ── */
.products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
.product-card {
  border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
  transition: border-color .2s, transform .2s;
}
.product-card:hover { border-color: var(--accent); transform: translateY(-2px); }
.product-top {
  background: var(--accent-light); padding: 32px 24px; text-align: center;
}
.product-top .product-icon { font-size: 2.4rem; margin-bottom: 8px; }
.product-top h3 { font-size: 1.1rem; font-family: 'DM Sans', sans-serif; font-weight: 700; }
.product-body { padding: 20px 24px; }
.product-body p { font-size: 0.88rem; color: var(--fg-muted); margin-bottom: 12px; }
.product-body ul { list-style: none; }
.product-body li {
  font-size: 0.82rem; padding: 4px 0;
  color: var(--fg-muted);
  display: flex; align-items: baseline; gap: 6px;
}
.product-body li::before { content: "→"; color: var(--accent); font-weight: 600; flex-shrink: 0; }

/* ── TOOLS ── */
.tools-flex { display: flex; flex-wrap: wrap; gap: 10px; }
.tool-pill {
  font-size: 0.82rem; font-weight: 500; padding: 8px 16px;
  border-radius: 24px; border: 1px solid var(--border);
  background: var(--bg-alt); color: var(--fg-muted);
  transition: all .2s;
}
.tool-pill:hover { border-color: var(--accent); color: var(--accent); }
.tool-pill.highlight { background: var(--accent-light); border-color: var(--accent); color: var(--accent); font-weight: 600; }

/* ── TIMELINE ── */
.timeline { position: relative; padding-left: 32px; }
.timeline::before {
  content: ''; position: absolute; left: 7px; top: 6px; bottom: 6px;
  width: 2px; background: var(--border);
}
.tl-item { position: relative; margin-bottom: 32px; }
.tl-item:last-child { margin-bottom: 0; }
.tl-item::before {
  content: ''; position: absolute; left: -29px; top: 7px;
  width: 12px; height: 12px; border-radius: 50%;
  background: var(--accent); border: 3px solid var(--bg);
}
.tl-item .tl-date { font-size: 0.78rem; font-weight: 600; color: var(--accent); margin-bottom: 2px; }
.tl-item h3 { font-size: 1rem; font-family: 'DM Sans', sans-serif; font-weight: 600; margin-bottom: 4px; }
.tl-item p { font-size: 0.88rem; color: var(--fg-muted); }

/* ── CTA FINAL ── */
.final-cta {
  background: var(--accent); color: #fff; padding: 64px 0; text-align: center;
  border-radius: 16px; margin: 0 24px 72px;
}
.final-cta h2 { font-size: 1.8rem; color: #fff; margin-bottom: 12px; }
.final-cta p { font-size: 1rem; opacity: .9; max-width: 500px; margin: 0 auto 28px; }
.btn-white { background: #fff; color: var(--accent); }
.btn-white:hover { background: var(--accent-light); text-decoration: none; }

/* ── FOOTER ── */
footer {
  border-top: 1px solid var(--border); padding: 32px 0; text-align: center;
  font-size: 0.82rem; color: var(--fg-muted);
}
footer a { color: var(--accent); }

@media (max-width: 600px) {
  .hero { padding: 48px 0 40px; }
  .hero h1 { font-size: 1.8rem; }
  section { padding: 48px 0; }
  .section-title { font-size: 1.4rem; }
}

/* Commercial catalog */
.product-card{display:flex;flex-direction:column}.product-body{display:flex;flex:1;flex-direction:column}
.product-body ul{margin-bottom:18px}.product-order{display:flex;gap:10px;flex-wrap:wrap;margin-top:auto;padding-top:16px}
.product-order a{display:inline-flex;align-items:center;justify-content:center;border-radius:6px;padding:9px 14px;font-size:.83rem;font-weight:700;background:var(--accent);color:#fff}
.product-order a:hover{background:var(--accent-dark);text-decoration:none}
.product-order a.secondary{background:transparent;color:var(--accent);border:1px solid var(--accent)}
.sale-note{margin:4px 0 20px;color:var(--fg-muted);font-size:.85rem}
.availability{display:inline-block;color:var(--accent);font-size:.75rem;font-weight:700;margin-top:9px}
</style>
</head>
